{
  "name": "cs-roadmap",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "npm run syllabus:export && node scripts/export-roadmap.mjs && vite build --configLoader runner",
